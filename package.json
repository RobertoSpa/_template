{
  "name": "template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "a11y": "node scripts/accessibility.ts",
    "a11y:attest": "node scripts/accessibility.ts attest",
    "a11y:keyboard": "node scripts/accessibility.ts keyboard",
    "a11y:policy": "node scripts/accessibility.ts policy",
    "a11y:static": "node scripts/accessibility.ts static",
    "a11y:tokens": "node scripts/accessibility.ts tokens",
    "a11y:tree": "node scripts/accessibility.ts tree",
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "vite",
    "explain": "node scripts/explain.ts",
    "format": "prettier --write . && eslint . --fix",
    "gate:flaky": "bash scripts/repeatChangedTests.sh",
    "gates": "pnpm a11y && pnpm security && pnpm resilience",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "lint:fsd": "steiger ./src",
    "prepare": "git config core.hooksPath .githooks && playwright install chromium",
    "preview": "vite preview",
    "resilience": "node scripts/resilience.ts",
    "resilience:fault": "node scripts/resilience.ts fault",
    "resilience:policy": "node scripts/resilience.ts policy",
    "resilience:routes": "node scripts/resilience.ts routes",
    "security": "node scripts/security.ts",
    "security:actions": "node scripts/security.ts actions",
    "security:code": "node scripts/security.ts code",
    "security:deps": "node scripts/security.ts deps",
    "security:policy": "node scripts/security.ts policy",
    "security:secrets": "node scripts/security.ts secrets",
    "shot": "node scripts/shot.ts",
    "test": "pnpm test:unit -- --run && pnpm test:e2e",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:integration": "vitest run --project integration",
    "test:mutation": "stryker run",
    "test:unit": "vitest --project client --project server"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-config-canonical": "47.4.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "smol-toml": "1.8.0",
    "steiger": "0.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
