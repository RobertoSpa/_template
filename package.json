{
  "name": "template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "vite",
    "format": "prettier --write . && eslint . --fix",
    "gate:flaky": "bash scripts/repeatChangedTests.sh",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "lint:fsd": "steiger ./src",
    "prepare": "git config core.hooksPath .githooks && playwright install chromium",
    "preview": "vite preview",
    "security": "node scripts/security.ts",
    "security:actions": "node scripts/security.ts actions",
    "security:code": "node scripts/security.ts code",
    "security:deps": "node scripts/security.ts deps",
    "security:policy": "node scripts/security.ts policy",
    "security:secrets": "node scripts/security.ts secrets",
    "shot": "node scripts/shot.ts",
    "test": "pnpm test:unit -- --run && pnpm test:e2e",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:integration": "vitest run --project integration",
    "test:mutation": "stryker run",
    "test:unit": "vitest --project client --project server"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-canonical": "^47.4.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.11.0",
    "knip": "^6.35.1",
    "playwright": "^1.60.0",
    "prettier": "^3.9.6",
    "smol-toml": "^1.8.0",
    "steiger": "^0.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  }
}
