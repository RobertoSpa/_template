# One line for each variable that parseEnvironment reads in src/shared/parse/environment.ts.
# MODE is the one variable at this time. Vite sets it from its --mode flag, and a .env file cannot set it.
#
# Vite ships each VITE_ variable to the browser. A VITE_ name with the word
# SECRET, TOKEN, PASSWORD, or PRIVATE stops the build. See vite.config.ts.
